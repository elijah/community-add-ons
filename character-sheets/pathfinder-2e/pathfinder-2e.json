{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "pathfinder-2e",
  "name": "Pathfinder 2e",
  "version": "1.0.0",
  "system": "Pathfinder Second Edition",
  "description": "A character sheet for Pathfinder 2e: proficiency ranks that add your level once trained, three saves, bulk-based encumbrance, and rank-based spellcasting.",
  "author": "hunter-read",
  "homepage": "https://paizo.com/orclicense",
  "license": "ORC",
  "license_url": "https://paizo.com/orclicense",
  "attribution": "This product is based on the Pathfinder Second Edition rules, published by Paizo Inc. under the ORC License. Pathfinder is a trademark of Paizo Inc. See https://paizo.com/orclicense.",
  "content_types": {
    "class": {
      "label": "Class",
      "label_plural": "Classes",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "key_ability"
      ],
      "compact_display": "{name} — {key_ability}, {hp_per_level} HP/level",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "key_ability": {
          "type": "text",
          "label": "Key Ability"
        },
        "hp_per_level": {
          "type": "number",
          "label": "HP per Level"
        },
        "perception": {
          "type": "text",
          "label": "Perception"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "ancestry": {
      "label": "Ancestry",
      "label_plural": "Ancestries",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "size"
      ],
      "compact_display": "{name} — {size}, {hp} HP",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "hp": {
          "type": "number",
          "label": "Ancestry HP"
        },
        "size": {
          "type": "text",
          "label": "Size"
        },
        "speed": {
          "type": "number",
          "label": "Speed"
        },
        "boosts": {
          "type": "text",
          "label": "Ability Boosts"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "feat": {
      "label": "Feat",
      "label_plural": "Feats",
      "identity_field": "name",
      "sort_default": [
        "level",
        "name"
      ],
      "search_fields": [
        "name",
        "traits",
        "description"
      ],
      "filter_fields": [
        "level",
        "category",
        "traits"
      ],
      "compact_display": "{name} — {category} {level}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "level": {
          "type": "number",
          "label": "Level"
        },
        "category": {
          "type": "text",
          "label": "Category"
        },
        "traits": {
          "type": "text",
          "label": "Traits"
        },
        "prerequisites": {
          "type": "text",
          "label": "Prerequisites"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "spell": {
      "label": "Spell",
      "label_plural": "Spells",
      "identity_field": "name",
      "sort_default": [
        "rank",
        "name"
      ],
      "search_fields": [
        "name",
        "traits",
        "description"
      ],
      "filter_fields": [
        "rank",
        "tradition",
        "traits"
      ],
      "compact_display": "{name} — rank {rank}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "rank": {
          "type": "number",
          "label": "Rank",
          "min": 0,
          "max": 10
        },
        "tradition": {
          "type": "text",
          "label": "Traditions"
        },
        "traits": {
          "type": "text",
          "label": "Traits"
        },
        "cast": {
          "type": "text",
          "label": "Cast"
        },
        "range": {
          "type": "text",
          "label": "Range"
        },
        "targets": {
          "type": "text",
          "label": "Targets"
        },
        "saving_throw": {
          "type": "text",
          "label": "Saving Throw"
        },
        "duration": {
          "type": "text",
          "label": "Duration"
        },
        "heightened": {
          "type": "textarea",
          "label": "Heightened"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    }
  },
  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Character Name"
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 20,
      "default": 1
    },
    "ancestry": {
      "type": "content_ref",
      "label": "Ancestry",
      "content_type": "ancestry"
    },
    "heritage": {
      "type": "text",
      "label": "Heritage"
    },
    "background": {
      "type": "text",
      "label": "Background"
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class"
    },
    "size": {
      "type": "select",
      "label": "Size",
      "options": [
        "Tiny",
        "Small",
        "Medium",
        "Large",
        "Huge"
      ]
    },
    "strength": {
      "type": "number",
      "label": "Strength",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "dexterity": {
      "type": "number",
      "label": "Dexterity",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "constitution": {
      "type": "number",
      "label": "Constitution",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "intelligence": {
      "type": "number",
      "label": "Intelligence",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "wisdom": {
      "type": "number",
      "label": "Wisdom",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "charisma": {
      "type": "number",
      "label": "Charisma",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "hp_max": {
      "type": "number",
      "label": "Max HP",
      "min": 0,
      "default": 10
    },
    "hp_current": {
      "type": "number",
      "label": "Current HP",
      "min": 0,
      "default": 10
    },
    "hp_temp": {
      "type": "number",
      "label": "Temporary HP",
      "min": 0,
      "default": 0
    },
    "dying": {
      "type": "number",
      "label": "Dying",
      "min": 0,
      "max": 4,
      "default": 0
    },
    "wounded": {
      "type": "number",
      "label": "Wounded",
      "min": 0,
      "max": 3,
      "default": 0
    },
    "hero_points": {
      "type": "number",
      "label": "Hero Points",
      "min": 0,
      "max": 3,
      "default": 1
    },
    "speed": {
      "type": "number",
      "label": "Speed",
      "min": 0,
      "default": 25
    },
    "ac_prof": {
      "type": "select",
      "label": "Armour Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "ac_item_bonus": {
      "type": "number",
      "label": "Armour Item Bonus",
      "min": 0,
      "default": 0
    },
    "ac_dex_cap": {
      "type": "number",
      "label": "Dex Cap",
      "min": 0,
      "default": 5
    },
    "fortitude_prof": {
      "type": "select",
      "label": "Fortitude Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "reflex_prof": {
      "type": "select",
      "label": "Reflex Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "will_prof": {
      "type": "select",
      "label": "Will Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "perception_prof": {
      "type": "select",
      "label": "Perception Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "class_dc_prof": {
      "type": "select",
      "label": "Class DC Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "key_ability": {
      "type": "select",
      "label": "Key Ability",
      "options": [
        {
          "value": "strength",
          "label": "Strength"
        },
        {
          "value": "dexterity",
          "label": "Dexterity"
        },
        {
          "value": "constitution",
          "label": "Constitution"
        },
        {
          "value": "intelligence",
          "label": "Intelligence"
        },
        {
          "value": "wisdom",
          "label": "Wisdom"
        },
        {
          "value": "charisma",
          "label": "Charisma"
        }
      ]
    },
    "is_caster": {
      "type": "checkbox",
      "label": "Spellcaster"
    },
    "spell_tradition": {
      "type": "select",
      "label": "Tradition",
      "visible_if": "is_caster",
      "options": [
        "Arcane",
        "Divine",
        "Occult",
        "Primal"
      ]
    },
    "spell_prof": {
      "type": "select",
      "label": "Spellcasting Proficiency",
      "visible_if": "is_caster",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "spells": {
      "type": "content_list",
      "label": "Spells",
      "content_type": "spell",
      "allow_freeform": true,
      "visible_if": "is_caster",
      "per_entry_fields": {
        "prepared": {
          "type": "checkbox",
          "label": "Prep"
        }
      }
    },
    "feats": {
      "type": "content_list",
      "label": "Feats",
      "content_type": "feat",
      "allow_freeform": true
    },
    "skills": {
      "type": "list",
      "label": "Skills",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Skill",
          "flex": 3
        },
        {
          "key": "prof",
          "type": "select",
          "label": "Proficiency",
          "options": [
            {
              "value": 0,
              "label": "Untrained"
            },
            {
              "value": 2,
              "label": "Trained"
            },
            {
              "value": 4,
              "label": "Expert"
            },
            {
              "value": 6,
              "label": "Master"
            },
            {
              "value": 8,
              "label": "Legendary"
            }
          ],
          "default": 0,
          "flex": 2
        },
        {
          "key": "ability",
          "type": "select",
          "label": "Ability",
          "options": [
            {
              "value": "strength",
              "label": "STR"
            },
            {
              "value": "dexterity",
              "label": "DEX"
            },
            {
              "value": "constitution",
              "label": "CON"
            },
            {
              "value": "intelligence",
              "label": "INT"
            },
            {
              "value": "wisdom",
              "label": "WIS"
            },
            {
              "value": "charisma",
              "label": "CHA"
            }
          ],
          "flex": 1
        },
        {
          "key": "item",
          "type": "number",
          "label": "Item",
          "default": 0,
          "flex": 1
        }
      ]
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "bulk",
          "type": "number",
          "label": "Bulk",
          "default": 0,
          "min": 0,
          "flex": 1
        },
        {
          "key": "invested",
          "type": "checkbox",
          "label": "Inv."
        }
      ]
    },
    "notes": {
      "type": "textarea",
      "label": "Notes",
      "rows": 6
    }
  },
  "computed": {
    "armor_class": {
      "formula": "10 + min(dexterity, ac_dex_cap) + ac_item_bonus + (ac_prof > 0 ? level + ac_prof : 0)",
      "label": "Armour Class"
    },
    "fortitude": {
      "formula": "signed(constitution + (fortitude_prof > 0 ? level + fortitude_prof : 0))",
      "label": "Fortitude"
    },
    "reflex": {
      "formula": "signed(dexterity + (reflex_prof > 0 ? level + reflex_prof : 0))",
      "label": "Reflex"
    },
    "will": {
      "formula": "signed(wisdom + (will_prof > 0 ? level + will_prof : 0))",
      "label": "Will"
    },
    "perception": {
      "formula": "signed(wisdom + (perception_prof > 0 ? level + perception_prof : 0))",
      "label": "Perception"
    },
    "class_dc": {
      "formula": "10 + (class_dc_prof > 0 ? level + class_dc_prof : 0) + (key_ability == 'strength' ? strength : (key_ability == 'dexterity' ? dexterity : (key_ability == 'constitution' ? constitution : (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma)))))",
      "label": "Class DC"
    },
    "spell_dc": {
      "formula": "10 + (spell_prof > 0 ? level + spell_prof : 0) + (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma))",
      "label": "Spell DC"
    },
    "spell_attack": {
      "formula": "signed((spell_prof > 0 ? level + spell_prof : 0) + (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma)))",
      "label": "Spell Attack"
    },
    "bulk_carried": {
      "formula": "sum_where(equipment, 'bulk')",
      "label": "Bulk"
    },
    "bulk_limit": {
      "formula": "5 + strength",
      "label": "Bulk Limit"
    },
    "invested_count": {
      "formula": "count_where(equipment, 'invested')",
      "label": "Invested"
    },
    "prepared_count": {
      "formula": "count_refs(spells, 'prepared')",
      "label": "Prepared"
    }
  },
  "layout_file": "pathfinder-2e.html",
  "styles_file": "pathfinder-2e.css"
}
