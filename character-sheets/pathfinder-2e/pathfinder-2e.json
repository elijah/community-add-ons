{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "pathfinder-2e",
  "name": "Pathfinder 2e",
  "version": "1.0.0",
  "system": "Pathfinder Second Edition",
  "description": "A character sheet for Pathfinder 2e: proficiency ranks that add your level once trained, three saves, bulk-based encumbrance, and rank-based spellcasting.",
  "author": "hunter-read",
  "homepage": "https://paizo.com/orclicense",
  "license": "ORC",
  "license_url": "https://paizo.com/orclicense",
  "attribution": "This product is based on the Pathfinder Second Edition rules, published by Paizo Inc. under the ORC License. Pathfinder is a trademark of Paizo Inc. See https://paizo.com/orclicense.",
  "content_types": {
    "class": {
      "label": "Class",
      "label_plural": "Classes",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "key_ability"
      ],
      "compact_display": "{name} — {key_ability}, {hp_per_level} HP/level",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "key_ability": {
          "type": "text",
          "label": "Key Ability"
        },
        "hp_per_level": {
          "type": "number",
          "label": "HP per Level"
        },
        "perception": {
          "type": "text",
          "label": "Perception"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "ancestry": {
      "label": "Ancestry",
      "label_plural": "Ancestries",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "size"
      ],
      "compact_display": "{name} — {size}, {hp} HP",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "hp": {
          "type": "number",
          "label": "Ancestry HP"
        },
        "size": {
          "type": "text",
          "label": "Size"
        },
        "speed": {
          "type": "number",
          "label": "Speed"
        },
        "boosts": {
          "type": "text",
          "label": "Ability Boosts"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "feat": {
      "label": "Feat",
      "label_plural": "Feats",
      "identity_field": "name",
      "sort_default": [
        "level",
        "name"
      ],
      "search_fields": [
        "name",
        "traits",
        "description"
      ],
      "filter_fields": [
        "level",
        "category",
        "traits"
      ],
      "compact_display": "{name} — {category} {level}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "level": {
          "type": "number",
          "label": "Level"
        },
        "category": {
          "type": "text",
          "label": "Category"
        },
        "traits": {
          "type": "text",
          "label": "Traits"
        },
        "prerequisites": {
          "type": "text",
          "label": "Prerequisites"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "spell": {
      "label": "Spell",
      "label_plural": "Spells",
      "identity_field": "name",
      "sort_default": [
        "rank",
        "name"
      ],
      "search_fields": [
        "name",
        "traits",
        "description"
      ],
      "filter_fields": [
        "rank",
        "tradition",
        "traits"
      ],
      "compact_display": "{name} — rank {rank}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "rank": {
          "type": "number",
          "label": "Rank",
          "min": 0,
          "max": 10
        },
        "tradition": {
          "type": "text",
          "label": "Traditions"
        },
        "traits": {
          "type": "text",
          "label": "Traits"
        },
        "cast": {
          "type": "text",
          "label": "Cast"
        },
        "range": {
          "type": "text",
          "label": "Range"
        },
        "targets": {
          "type": "text",
          "label": "Targets"
        },
        "saving_throw": {
          "type": "text",
          "label": "Saving Throw"
        },
        "duration": {
          "type": "text",
          "label": "Duration"
        },
        "heightened": {
          "type": "textarea",
          "label": "Heightened"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    }
  },
  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Character Name"
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 20,
      "default": 1
    },
    "ancestry": {
      "type": "content_ref",
      "label": "Ancestry",
      "content_type": "ancestry"
    },
    "heritage": {
      "type": "text",
      "label": "Heritage"
    },
    "background": {
      "type": "text",
      "label": "Background"
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class"
    },
    "size": {
      "type": "select",
      "label": "Size",
      "options": [
        "Tiny",
        "Small",
        "Medium",
        "Large",
        "Huge"
      ]
    },
    "strength": {
      "type": "number",
      "label": "Strength",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "dexterity": {
      "type": "number",
      "label": "Dexterity",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "constitution": {
      "type": "number",
      "label": "Constitution",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "intelligence": {
      "type": "number",
      "label": "Intelligence",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "wisdom": {
      "type": "number",
      "label": "Wisdom",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "charisma": {
      "type": "number",
      "label": "Charisma",
      "min": -5,
      "max": 10,
      "default": 0,
      "placeholder": "Modifier, not score"
    },
    "hp_max": {
      "type": "number",
      "label": "Max HP",
      "min": 0,
      "default": 10
    },
    "hp_current": {
      "type": "number",
      "label": "Current HP",
      "min": 0,
      "default": 10
    },
    "hp_temp": {
      "type": "number",
      "label": "Temporary HP",
      "min": 0,
      "default": 0
    },
    "dying": {
      "type": "number",
      "label": "Dying",
      "min": 0,
      "max": 4,
      "default": 0
    },
    "wounded": {
      "type": "number",
      "label": "Wounded",
      "min": 0,
      "max": 3,
      "default": 0
    },
    "hero_points": {
      "type": "number",
      "label": "Hero Points",
      "min": 0,
      "max": 3,
      "default": 1
    },
    "speed": {
      "type": "number",
      "label": "Speed",
      "min": 0,
      "default": 25
    },
    "ac_prof": {
      "type": "select",
      "label": "Armour Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "ac_item_bonus": {
      "type": "number",
      "label": "Armour Item Bonus",
      "min": 0,
      "default": 0
    },
    "ac_dex_cap": {
      "type": "number",
      "label": "Dex Cap",
      "min": 0,
      "default": 5
    },
    "fortitude_prof": {
      "type": "select",
      "label": "Fortitude Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "reflex_prof": {
      "type": "select",
      "label": "Reflex Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "will_prof": {
      "type": "select",
      "label": "Will Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "perception_prof": {
      "type": "select",
      "label": "Perception Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "class_dc_prof": {
      "type": "select",
      "label": "Class DC Proficiency",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "key_ability": {
      "type": "select",
      "label": "Key Ability",
      "options": [
        {
          "value": "strength",
          "label": "Strength"
        },
        {
          "value": "dexterity",
          "label": "Dexterity"
        },
        {
          "value": "constitution",
          "label": "Constitution"
        },
        {
          "value": "intelligence",
          "label": "Intelligence"
        },
        {
          "value": "wisdom",
          "label": "Wisdom"
        },
        {
          "value": "charisma",
          "label": "Charisma"
        }
      ]
    },
    "is_caster": {
      "type": "checkbox",
      "label": "Spellcaster"
    },
    "spell_tradition": {
      "type": "select",
      "label": "Tradition",
      "visible_if": "is_caster",
      "options": [
        "Arcane",
        "Divine",
        "Occult",
        "Primal"
      ]
    },
    "spell_prof": {
      "type": "select",
      "label": "Spellcasting Proficiency",
      "visible_if": "is_caster",
      "options": [
        {
          "value": 0,
          "label": "Untrained"
        },
        {
          "value": 2,
          "label": "Trained"
        },
        {
          "value": 4,
          "label": "Expert"
        },
        {
          "value": 6,
          "label": "Master"
        },
        {
          "value": 8,
          "label": "Legendary"
        }
      ],
      "default": 2
    },
    "spells": {
      "type": "content_list",
      "label": "Spells",
      "content_type": "spell",
      "allow_freeform": true,
      "visible_if": "is_caster",
      "per_entry_fields": {
        "prepared": {
          "type": "checkbox",
          "label": "Prep"
        }
      }
    },
    "feats": {
      "type": "content_list",
      "label": "Feats",
      "content_type": "feat",
      "allow_freeform": true
    },
    "skills": {
      "type": "list",
      "label": "Skills",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Skill",
          "flex": 3
        },
        {
          "key": "prof",
          "type": "select",
          "label": "Proficiency",
          "options": [
            {
              "value": 0,
              "label": "Untrained"
            },
            {
              "value": 2,
              "label": "Trained"
            },
            {
              "value": 4,
              "label": "Expert"
            },
            {
              "value": 6,
              "label": "Master"
            },
            {
              "value": 8,
              "label": "Legendary"
            }
          ],
          "default": 0,
          "flex": 2
        },
        {
          "key": "ability",
          "type": "select",
          "label": "Ability",
          "options": [
            {
              "value": "strength",
              "label": "STR"
            },
            {
              "value": "dexterity",
              "label": "DEX"
            },
            {
              "value": "constitution",
              "label": "CON"
            },
            {
              "value": "intelligence",
              "label": "INT"
            },
            {
              "value": "wisdom",
              "label": "WIS"
            },
            {
              "value": "charisma",
              "label": "CHA"
            }
          ],
          "flex": 1
        },
        {
          "key": "item",
          "type": "number",
          "label": "Item",
          "default": 0,
          "flex": 1
        }
      ]
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "bulk",
          "type": "number",
          "label": "Bulk",
          "default": 0,
          "min": 0,
          "flex": 1
        },
        {
          "key": "invested",
          "type": "checkbox",
          "label": "Inv."
        }
      ]
    },
    "notes": {
      "type": "textarea",
      "label": "Notes",
      "rows": 6
    }
  },
  "computed": {
    "armor_class": {
      "formula": "10 + min(dexterity, ac_dex_cap) + ac_item_bonus + (ac_prof > 0 ? level + ac_prof : 0)",
      "label": "Armour Class"
    },
    "fortitude": {
      "formula": "signed(constitution + (fortitude_prof > 0 ? level + fortitude_prof : 0))",
      "label": "Fortitude"
    },
    "reflex": {
      "formula": "signed(dexterity + (reflex_prof > 0 ? level + reflex_prof : 0))",
      "label": "Reflex"
    },
    "will": {
      "formula": "signed(wisdom + (will_prof > 0 ? level + will_prof : 0))",
      "label": "Will"
    },
    "perception": {
      "formula": "signed(wisdom + (perception_prof > 0 ? level + perception_prof : 0))",
      "label": "Perception"
    },
    "class_dc": {
      "formula": "10 + (class_dc_prof > 0 ? level + class_dc_prof : 0) + (key_ability == 'strength' ? strength : (key_ability == 'dexterity' ? dexterity : (key_ability == 'constitution' ? constitution : (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma)))))",
      "label": "Class DC"
    },
    "spell_dc": {
      "formula": "10 + (spell_prof > 0 ? level + spell_prof : 0) + (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma))",
      "label": "Spell DC"
    },
    "spell_attack": {
      "formula": "signed((spell_prof > 0 ? level + spell_prof : 0) + (key_ability == 'intelligence' ? intelligence : (key_ability == 'wisdom' ? wisdom : charisma)))",
      "label": "Spell Attack"
    },
    "bulk_carried": {
      "formula": "sum_where(equipment, 'bulk')",
      "label": "Bulk"
    },
    "bulk_limit": {
      "formula": "5 + strength",
      "label": "Bulk Limit"
    },
    "invested_count": {
      "formula": "count_where(equipment, 'invested')",
      "label": "Invested"
    },
    "prepared_count": {
      "formula": "count_refs(spells, 'prepared')",
      "label": "Prepared"
    }
  },
  "layout_html": "<div class=\"sheet-pf2\">\n  <header class=\"identity\">\n    <g-field name=\"hero_name\" />\n    <div class=\"identity-row\">\n      <g-field name=\"klass\" /><g-field name=\"level\" />\n      <g-field name=\"ancestry\" /><g-field name=\"heritage\" />\n      <g-field name=\"background\" /><g-field name=\"key_ability\" />\n    </div>\n  </header>\n\n  <section class=\"abilities\">\n      <div class=\"ability\">\n        <g-label name=\"strength\" />\n        <g-field name=\"strength\" label=\"\" />\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"dexterity\" />\n        <g-field name=\"dexterity\" label=\"\" />\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"constitution\" />\n        <g-field name=\"constitution\" label=\"\" />\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"intelligence\" />\n        <g-field name=\"intelligence\" label=\"\" />\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"wisdom\" />\n        <g-field name=\"wisdom\" label=\"\" />\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"charisma\" />\n        <g-field name=\"charisma\" label=\"\" />\n      </div>\n  </section>\n\n  <section class=\"defences\">\n    <div class=\"stat\"><span class=\"stat-label\">AC</span><g-value name=\"armor_class\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Fortitude</span><g-value name=\"fortitude\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Reflex</span><g-value name=\"reflex\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Will</span><g-value name=\"will\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Perception</span><g-value name=\"perception\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Class DC</span><g-value name=\"class_dc\" /></div>\n  </section>\n\n  <section class=\"vitals\">\n    <g-field name=\"hp_current\" /><g-field name=\"hp_max\" /><g-field name=\"hp_temp\" />\n    <g-field name=\"dying\" /><g-field name=\"wounded\" /><g-field name=\"hero_points\" />\n  </section>\n\n  <div class=\"columns\">\n    <div class=\"col\">\n      <g-section title=\"Proficiencies\">\n        <g-field name=\"ac_prof\" /><g-field name=\"ac_item_bonus\" /><g-field name=\"ac_dex_cap\" />\n        <g-field name=\"fortitude_prof\" /><g-field name=\"reflex_prof\" /><g-field name=\"will_prof\" />\n        <g-field name=\"perception_prof\" /><g-field name=\"class_dc_prof\" />\n      </g-section>\n      <g-section title=\"Movement\">\n        <g-field name=\"speed\" /><g-field name=\"size\" />\n      </g-section>\n    </div>\n\n    <div class=\"col wide\">\n      <g-section title=\"Skills\"><g-field name=\"skills\" label=\"\" /></g-section>\n      <g-section title=\"Feats\"><g-field name=\"feats\" label=\"\" /></g-section>\n      <g-section title=\"Equipment\">\n        <g-field name=\"equipment\" label=\"\" />\n        <p class=\"hint\">\n          Bulk <g-value name=\"bulk_carried\" /> of <g-value name=\"bulk_limit\" />\n          · <g-value name=\"invested_count\" /> invested\n        </p>\n      </g-section>\n      <g-if test=\"is_caster\">\n        <g-section title=\"Spellcasting\">\n          <div class=\"spell-stats\">\n            <g-field name=\"spell_tradition\" /><g-field name=\"spell_prof\" />\n            <div class=\"stat\"><span class=\"stat-label\">Spell DC</span><g-value name=\"spell_dc\" /></div>\n            <div class=\"stat\"><span class=\"stat-label\">Attack</span><g-value name=\"spell_attack\" /></div>\n          </div>\n          <g-field name=\"spells\" label=\"\" />\n        </g-section>\n      </g-if>\n      <g-section title=\"Notes\"><g-field name=\"notes\" label=\"\" /></g-section>\n    </div>\n  </div>\n\n  <g-field name=\"is_caster\" />\n</div>",
  "styles": ".sheet-pf2 { display: grid; gap: 18px; }\n.identity { display: grid; gap: 10px; }\n.identity-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\n.abilities { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 10px; }\n.ability { text-align: center; border: 1px solid var(--border); border-radius: 10px; padding: 8px 6px; }\n.defences, .vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }\n.stat { text-align: center; border: 1px solid var(--border); border-radius: 10px; padding: 8px; }\n.stat-label { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }\n.columns { display: grid; grid-template-columns: 1fr 2fr; gap: 18px; }\n.col { display: grid; gap: 14px; align-content: start; }\n.spell-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; margin-bottom: 10px; }\n.hint { font-size: 11px; color: var(--text-muted); margin: 6px 0 0; }\n@media (max-width: 720px) { .columns { grid-template-columns: 1fr; } }"
}
