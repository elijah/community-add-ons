{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "draw-steel",
  "name": "Draw Steel",
  "version": "1.0.0",
  "system": "Draw Steel",
  "description": "A hero sheet for MCDM's Draw Steel: five characteristics, stamina and recoveries, a heroic resource, and abilities with power-roll tiers.",
  "author": "hunter-read",
  "homepage": "https://www.mcdmproductions.com/draw-steel-creator-license",
  "license": "Draw Steel Creator License",
  "license_url": "https://www.mcdmproductions.com/draw-steel-creator-license",
  "attribution": "Grimoire is an independent product published under the DRAW STEEL Creator License and is not affiliated with MCDM Productions, LLC. DRAW STEEL © 2026 MCDM Productions, LLC.",
  "content_types": {
    "class": {
      "label": "Class",
      "label_plural": "Classes",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "heroic_resource"
      ],
      "compact_display": "{name} — {heroic_resource}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "heroic_resource": {
          "type": "text",
          "label": "Heroic Resource"
        },
        "starting_stamina": {
          "type": "number",
          "label": "Starting Stamina"
        },
        "stamina_per_level": {
          "type": "number",
          "label": "Stamina per Level"
        },
        "recoveries": {
          "type": "number",
          "label": "Recoveries"
        },
        "characteristics": {
          "type": "text",
          "label": "Characteristics"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "ancestry": {
      "label": "Ancestry",
      "label_plural": "Ancestries",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [],
      "compact_display": "{name} — size {size}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "size": {
          "type": "text",
          "label": "Size"
        },
        "speed": {
          "type": "number",
          "label": "Speed"
        },
        "traits": {
          "type": "textarea",
          "label": "Signature Traits"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "kit": {
      "label": "Kit",
      "label_plural": "Kits",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "armor",
        "weapon"
      ],
      "compact_display": "{name} — {armor}, {weapon}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "armor": {
          "type": "text",
          "label": "Armour"
        },
        "weapon": {
          "type": "text",
          "label": "Weapon"
        },
        "stamina_bonus": {
          "type": "number",
          "label": "Stamina Bonus"
        },
        "speed_bonus": {
          "type": "number",
          "label": "Speed Bonus"
        },
        "stability_bonus": {
          "type": "number",
          "label": "Stability Bonus"
        },
        "damage_bonus": {
          "type": "text",
          "label": "Damage Bonus"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "ability": {
      "label": "Ability",
      "label_plural": "Abilities",
      "identity_field": "name",
      "sort_default": [
        "cost",
        "name"
      ],
      "search_fields": [
        "name",
        "keywords",
        "description"
      ],
      "filter_fields": [
        "type",
        "cost",
        "keywords"
      ],
      "compact_display": "{name} — {type} ({cost})",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "cost": {
          "type": "text",
          "label": "Cost"
        },
        "type": {
          "type": "text",
          "label": "Type"
        },
        "keywords": {
          "type": "text",
          "label": "Keywords"
        },
        "distance": {
          "type": "text",
          "label": "Distance"
        },
        "target": {
          "type": "text",
          "label": "Target"
        },
        "power_roll": {
          "type": "text",
          "label": "Power Roll"
        },
        "tier_1": {
          "type": "text",
          "label": "≤11"
        },
        "tier_2": {
          "type": "text",
          "label": "12–16"
        },
        "tier_3": {
          "type": "text",
          "label": "17+"
        },
        "effect": {
          "type": "textarea",
          "label": "Effect"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    }
  },
  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Name"
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 10,
      "default": 1
    },
    "ancestry": {
      "type": "content_ref",
      "label": "Ancestry",
      "content_type": "ancestry"
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class"
    },
    "subclass": {
      "type": "text",
      "label": "Subclass"
    },
    "kit": {
      "type": "content_ref",
      "label": "Kit",
      "content_type": "kit"
    },
    "career": {
      "type": "text",
      "label": "Career"
    },
    "complication": {
      "type": "text",
      "label": "Complication"
    },
    "might": {
      "type": "number",
      "label": "Might",
      "min": -5,
      "max": 5,
      "default": 0
    },
    "agility": {
      "type": "number",
      "label": "Agility",
      "min": -5,
      "max": 5,
      "default": 0
    },
    "reason": {
      "type": "number",
      "label": "Reason",
      "min": -5,
      "max": 5,
      "default": 0
    },
    "intuition": {
      "type": "number",
      "label": "Intuition",
      "min": -5,
      "max": 5,
      "default": 0
    },
    "presence": {
      "type": "number",
      "label": "Presence",
      "min": -5,
      "max": 5,
      "default": 0
    },
    "stamina_max": {
      "type": "number",
      "label": "Stamina Maximum",
      "min": 0,
      "default": 20
    },
    "stamina_current": {
      "type": "number",
      "label": "Current Stamina",
      "default": 20
    },
    "recoveries_max": {
      "type": "number",
      "label": "Recoveries",
      "min": 0,
      "default": 8
    },
    "recoveries_used": {
      "type": "number",
      "label": "Recoveries Spent",
      "min": 0,
      "default": 0
    },
    "heroic_resource": {
      "type": "number",
      "label": "Heroic Resource",
      "min": 0,
      "default": 0
    },
    "resource_name": {
      "type": "text",
      "label": "Resource Name",
      "placeholder": "Focus, Drama, Ferocity…"
    },
    "victories": {
      "type": "number",
      "label": "Victories",
      "min": 0,
      "default": 0
    },
    "renown": {
      "type": "number",
      "label": "Renown",
      "min": 0,
      "default": 0
    },
    "speed": {
      "type": "number",
      "label": "Speed",
      "min": 0,
      "default": 5
    },
    "stability": {
      "type": "number",
      "label": "Stability",
      "min": 0,
      "default": 0
    },
    "size": {
      "type": "text",
      "label": "Size",
      "placeholder": "1M"
    },
    "abilities": {
      "type": "content_list",
      "label": "Abilities",
      "content_type": "ability",
      "allow_freeform": true
    },
    "skills": {
      "type": "multiselect",
      "label": "Skills",
      "options": [
        "Alertness",
        "Architecture",
        "Blacksmithing",
        "Brag",
        "Carpentry",
        "Climb",
        "Culture",
        "Deceive",
        "Drive",
        "Empathize",
        "Endurance",
        "Flirt",
        "Gymnastics",
        "Handle Animals",
        "Heal",
        "Hide",
        "History",
        "Interrogate",
        "Intimidate",
        "Jump",
        "Lead",
        "Lie",
        "Lift",
        "Magic",
        "Monsters",
        "Music",
        "Nature",
        "Navigate",
        "Perform",
        "Persuade",
        "Pick Lock",
        "Pick Pocket",
        "Read Person",
        "Ride",
        "Rumors",
        "Search",
        "Sneak",
        "Society",
        "Strategy",
        "Swim",
        "Timescape"
      ]
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "notes",
          "type": "text",
          "label": "Notes",
          "flex": 2
        }
      ]
    },
    "notes": {
      "type": "textarea",
      "label": "Notes",
      "rows": 6
    }
  },
  "computed": {
    "recoveries_left": {
      "formula": "max(0, recoveries_max - recoveries_used)",
      "label": "Recoveries Left"
    },
    "recovery_value": {
      "formula": "floor(stamina_max / 3)",
      "label": "Recovery Value"
    },
    "winded": {
      "formula": "floor(stamina_max / 2)",
      "label": "Winded At"
    },
    "is_winded": {
      "formula": "stamina_current <= winded ? 'Winded' : 'Steady'",
      "label": "Condition"
    },
    "dying_at": {
      "formula": "0 - winded",
      "label": "Dying At"
    },
    "ability_count": {
      "formula": "count_refs(abilities)",
      "label": "Abilities Known"
    },
    "might_display": {
      "formula": "signed(might)",
      "label": "Might"
    },
    "agility_display": {
      "formula": "signed(agility)",
      "label": "Agility"
    },
    "reason_display": {
      "formula": "signed(reason)",
      "label": "Reason"
    },
    "intuition_display": {
      "formula": "signed(intuition)",
      "label": "Intuition"
    },
    "presence_display": {
      "formula": "signed(presence)",
      "label": "Presence"
    }
  },
  "layout_file": "draw-steel.html",
  "styles_file": "draw-steel.css"
}
