{
  "$schema": "../../schema/character-sheet.schema.json",
  "id": "dnd-5e-2024",
  "name": "D&D 5th Edition (2024)",
  "version": "1.0.0",
  "system": "Dungeons & Dragons 5th Edition (2024)",
  "description": "A character sheet for the 2024 revision of D&D 5th Edition, with the SRD 5.2 catalogue of classes, species, backgrounds, feats and spells.",
  "author": "hunter-read",
  "homepage": "https://www.dndbeyond.com/srd",
  "license": "CC-BY-4.0",
  "license_url": "https://creativecommons.org/licenses/by/4.0/",
  "attribution": "This work includes material from the System Reference Document 5.2 (“SRD 5.2”) by Wizards of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2 is licensed under the Creative Commons Attribution 4.0 International License, available at https://creativecommons.org/licenses/by/4.0/legalcode.",
  "content_types": {
    "class": {
      "label": "Class",
      "label_plural": "Classes",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "hit_die"
      ],
      "compact_display": "{name} — d{hit_die}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "hit_die": {
          "type": "number",
          "label": "Hit Die"
        },
        "primary_ability": {
          "type": "text",
          "label": "Primary Ability"
        },
        "saving_throws": {
          "type": "text",
          "label": "Saving Throw Proficiencies"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "species": {
      "label": "Species",
      "label_plural": "Species",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "size"
      ],
      "compact_display": "{name} — {size}, speed {speed}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "size": {
          "type": "text",
          "label": "Size"
        },
        "speed": {
          "type": "number",
          "label": "Speed"
        },
        "traits": {
          "type": "textarea",
          "label": "Traits"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "background": {
      "label": "Background",
      "label_plural": "Backgrounds",
      "identity_field": "name",
      "sort_default": [
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [],
      "compact_display": "{name} — {ability_scores}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "ability_scores": {
          "type": "text",
          "label": "Ability Scores"
        },
        "feat": {
          "type": "text",
          "label": "Origin Feat"
        },
        "skill_proficiencies": {
          "type": "text",
          "label": "Skill Proficiencies"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "feat": {
      "label": "Feat",
      "label_plural": "Feats",
      "identity_field": "name",
      "sort_default": [
        "category",
        "name"
      ],
      "search_fields": [
        "name",
        "description"
      ],
      "filter_fields": [
        "category"
      ],
      "compact_display": "{name} — {category}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "category": {
          "type": "text",
          "label": "Category"
        },
        "prerequisite": {
          "type": "text",
          "label": "Prerequisite"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    },
    "spell": {
      "label": "Spell",
      "label_plural": "Spells",
      "identity_field": "name",
      "sort_default": [
        "level",
        "name"
      ],
      "search_fields": [
        "name",
        "school",
        "description"
      ],
      "filter_fields": [
        "level",
        "school",
        "concentration",
        "ritual"
      ],
      "compact_display": "{name} — {school} {level}",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name"
        },
        "level": {
          "type": "number",
          "label": "Level",
          "min": 0,
          "max": 9
        },
        "school": {
          "type": "text",
          "label": "School"
        },
        "casting_time": {
          "type": "text",
          "label": "Casting Time"
        },
        "range": {
          "type": "text",
          "label": "Range"
        },
        "components": {
          "type": "text",
          "label": "Components"
        },
        "duration": {
          "type": "text",
          "label": "Duration"
        },
        "concentration": {
          "type": "checkbox",
          "label": "Concentration"
        },
        "ritual": {
          "type": "checkbox",
          "label": "Ritual"
        },
        "description": {
          "type": "textarea",
          "label": "Description"
        }
      }
    }
  },
  "fields": {
    "hero_name": {
      "type": "text",
      "label": "Character Name"
    },
    "player_name": {
      "type": "text",
      "label": "Player"
    },
    "level": {
      "type": "number",
      "label": "Level",
      "min": 1,
      "max": 20,
      "default": 1
    },
    "species": {
      "type": "content_ref",
      "label": "Species",
      "content_type": "species"
    },
    "background": {
      "type": "content_ref",
      "label": "Background",
      "content_type": "background"
    },
    "klass": {
      "type": "content_ref",
      "label": "Class",
      "content_type": "class"
    },
    "alignment": {
      "type": "select",
      "label": "Alignment",
      "options": [
        "Lawful Good",
        "Neutral Good",
        "Chaotic Good",
        "Lawful Neutral",
        "True Neutral",
        "Chaotic Neutral",
        "Lawful Evil",
        "Neutral Evil",
        "Chaotic Evil"
      ]
    },
    "strength": {
      "type": "number",
      "label": "Strength",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "strength_save_prof": {
      "type": "checkbox",
      "label": "STR save proficiency"
    },
    "dexterity": {
      "type": "number",
      "label": "Dexterity",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "dexterity_save_prof": {
      "type": "checkbox",
      "label": "DEX save proficiency"
    },
    "constitution": {
      "type": "number",
      "label": "Constitution",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "constitution_save_prof": {
      "type": "checkbox",
      "label": "CON save proficiency"
    },
    "intelligence": {
      "type": "number",
      "label": "Intelligence",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "intelligence_save_prof": {
      "type": "checkbox",
      "label": "INT save proficiency"
    },
    "wisdom": {
      "type": "number",
      "label": "Wisdom",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "wisdom_save_prof": {
      "type": "checkbox",
      "label": "WIS save proficiency"
    },
    "charisma": {
      "type": "number",
      "label": "Charisma",
      "min": 1,
      "max": 30,
      "default": 10
    },
    "charisma_save_prof": {
      "type": "checkbox",
      "label": "CHA save proficiency"
    },
    "hp_max": {
      "type": "number",
      "label": "HP Maximum",
      "min": 0,
      "default": 8
    },
    "hp_current": {
      "type": "number",
      "label": "Current HP",
      "min": 0,
      "default": 8
    },
    "hp_temp": {
      "type": "number",
      "label": "Temporary HP",
      "min": 0,
      "default": 0
    },
    "hit_dice": {
      "type": "text",
      "label": "Hit Dice"
    },
    "armor_bonus": {
      "type": "number",
      "label": "Armour Class Bonus",
      "default": 0,
      "placeholder": "Armour, shield and other bonuses"
    },
    "speed": {
      "type": "number",
      "label": "Speed",
      "min": 0,
      "default": 30
    },
    "heroic_inspiration": {
      "type": "checkbox",
      "label": "Heroic Inspiration"
    },
    "skill_profs": {
      "type": "multiselect",
      "label": "Skill Proficiencies",
      "options": [
        "Acrobatics",
        "Animal Handling",
        "Arcana",
        "Athletics",
        "Deception",
        "History",
        "Insight",
        "Intimidation",
        "Investigation",
        "Medicine",
        "Nature",
        "Perception",
        "Performance",
        "Persuasion",
        "Religion",
        "Sleight of Hand",
        "Stealth",
        "Survival"
      ]
    },
    "is_caster": {
      "type": "checkbox",
      "label": "Spellcaster"
    },
    "spell_ability": {
      "type": "select",
      "label": "Spellcasting Ability",
      "visible_if": "is_caster",
      "options": [
        {
          "value": "intelligence",
          "label": "Intelligence"
        },
        {
          "value": "wisdom",
          "label": "Wisdom"
        },
        {
          "value": "charisma",
          "label": "Charisma"
        }
      ]
    },
    "spells": {
      "type": "content_list",
      "label": "Spells",
      "content_type": "spell",
      "allow_freeform": true,
      "visible_if": "is_caster",
      "per_entry_fields": {
        "prepared": {
          "type": "checkbox",
          "label": "Prep"
        }
      }
    },
    "feats": {
      "type": "content_list",
      "label": "Feats",
      "content_type": "feat",
      "allow_freeform": true
    },
    "equipment": {
      "type": "list",
      "label": "Equipment",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Item",
          "flex": 3
        },
        {
          "key": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1,
          "min": 0,
          "flex": 1
        },
        {
          "key": "weight",
          "type": "number",
          "label": "Lb",
          "default": 0,
          "min": 0,
          "flex": 1
        },
        {
          "key": "equipped",
          "type": "checkbox",
          "label": "Eq."
        }
      ]
    },
    "attacks": {
      "type": "list",
      "label": "Attacks",
      "columns": [
        {
          "key": "name",
          "type": "text",
          "label": "Attack",
          "flex": 3
        },
        {
          "key": "bonus",
          "type": "text",
          "label": "Bonus",
          "flex": 1
        },
        {
          "key": "damage",
          "type": "text",
          "label": "Damage",
          "flex": 2
        }
      ]
    },
    "features": {
      "type": "textarea",
      "label": "Features & Traits",
      "rows": 8
    },
    "notes": {
      "type": "textarea",
      "label": "Notes",
      "rows": 6
    }
  },
  "computed": {
    "proficiency": {
      "formula": "2 + floor((level - 1) / 4)",
      "label": "Proficiency Bonus"
    },
    "strength_mod": {
      "formula": "floor((strength - 10) / 2)",
      "label": "STR Modifier"
    },
    "strength_save": {
      "formula": "signed(strength_mod + (strength_save_prof ? proficiency : 0))",
      "label": "STR Save"
    },
    "dexterity_mod": {
      "formula": "floor((dexterity - 10) / 2)",
      "label": "DEX Modifier"
    },
    "dexterity_save": {
      "formula": "signed(dexterity_mod + (dexterity_save_prof ? proficiency : 0))",
      "label": "DEX Save"
    },
    "constitution_mod": {
      "formula": "floor((constitution - 10) / 2)",
      "label": "CON Modifier"
    },
    "constitution_save": {
      "formula": "signed(constitution_mod + (constitution_save_prof ? proficiency : 0))",
      "label": "CON Save"
    },
    "intelligence_mod": {
      "formula": "floor((intelligence - 10) / 2)",
      "label": "INT Modifier"
    },
    "intelligence_save": {
      "formula": "signed(intelligence_mod + (intelligence_save_prof ? proficiency : 0))",
      "label": "INT Save"
    },
    "wisdom_mod": {
      "formula": "floor((wisdom - 10) / 2)",
      "label": "WIS Modifier"
    },
    "wisdom_save": {
      "formula": "signed(wisdom_mod + (wisdom_save_prof ? proficiency : 0))",
      "label": "WIS Save"
    },
    "charisma_mod": {
      "formula": "floor((charisma - 10) / 2)",
      "label": "CHA Modifier"
    },
    "charisma_save": {
      "formula": "signed(charisma_mod + (charisma_save_prof ? proficiency : 0))",
      "label": "CHA Save"
    },
    "initiative": {
      "formula": "signed(dexterity_mod)",
      "label": "Initiative"
    },
    "armor_class": {
      "formula": "10 + dexterity_mod + armor_bonus",
      "label": "Armour Class"
    },
    "passive_perception": {
      "formula": "10 + wisdom_mod + (contains(skill_profs, 'Perception') ? proficiency : 0)",
      "label": "Passive Perception"
    },
    "spell_save_dc": {
      "formula": "8 + proficiency + (spell_ability == 'intelligence' ? intelligence_mod : (spell_ability == 'wisdom' ? wisdom_mod : charisma_mod))",
      "label": "Spell Save DC"
    },
    "spell_attack": {
      "formula": "signed(proficiency + (spell_ability == 'intelligence' ? intelligence_mod : (spell_ability == 'wisdom' ? wisdom_mod : charisma_mod)))",
      "label": "Spell Attack"
    },
    "prepared_count": {
      "formula": "count_refs(spells, 'prepared')",
      "label": "Spells Prepared"
    },
    "carried_weight": {
      "formula": "sum_where(equipment, 'weight')",
      "label": "Weight Carried"
    },
    "carry_capacity": {
      "formula": "strength * 15",
      "label": "Carrying Capacity"
    }
  },
  "layout_html": "<div class=\"sheet-5e\">\n  <header class=\"identity\">\n    <g-field name=\"hero_name\" />\n    <div class=\"identity-row\">\n      <g-field name=\"klass\" /><g-field name=\"level\" />\n      <g-field name=\"species\" /><g-field name=\"background\" />\n    </div>\n  </header>\n\n  <section class=\"abilities\">\n      <div class=\"ability\">\n        <g-label name=\"strength\" />\n        <g-field name=\"strength\" label=\"\" />\n        <div class=\"mod\"><g-value name=\"strength_mod\" /></div>\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"dexterity\" />\n        <g-field name=\"dexterity\" label=\"\" />\n        <div class=\"mod\"><g-value name=\"dexterity_mod\" /></div>\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"constitution\" />\n        <g-field name=\"constitution\" label=\"\" />\n        <div class=\"mod\"><g-value name=\"constitution_mod\" /></div>\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"intelligence\" />\n        <g-field name=\"intelligence\" label=\"\" />\n        <div class=\"mod\"><g-value name=\"intelligence_mod\" /></div>\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"wisdom\" />\n        <g-field name=\"wisdom\" label=\"\" />\n        <div class=\"mod\"><g-value name=\"wisdom_mod\" /></div>\n      </div>\n      <div class=\"ability\">\n        <g-label name=\"charisma\" />\n        <g-field name=\"charisma\" label=\"\" />\n        <div class=\"mod\"><g-value name=\"charisma_mod\" /></div>\n      </div>\n  </section>\n\n  <section class=\"vitals\">\n    <div class=\"stat\"><span class=\"stat-label\">Armour Class</span><g-value name=\"armor_class\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Initiative</span><g-value name=\"initiative\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Speed</span><g-value name=\"speed\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Proficiency</span><g-value name=\"proficiency\" /></div>\n    <div class=\"stat\"><span class=\"stat-label\">Passive Perception</span><g-value name=\"passive_perception\" /></div>\n  </section>\n\n  <section class=\"hp\">\n    <g-field name=\"hp_current\" /><g-field name=\"hp_max\" />\n    <g-field name=\"hp_temp\" /><g-field name=\"hit_dice\" />\n  </section>\n\n  <div class=\"columns\">\n    <div class=\"col\">\n      <g-section title=\"Saving Throws\">\n        <table class=\"saves\">\n          <tbody>\n        <tr><td>STR</td><td class=\"tick\"><g-field name=\"strength_save_prof\" label=\"\" /></td><td class=\"num\"><g-value name=\"strength_save\" /></td></tr>\n        <tr><td>DEX</td><td class=\"tick\"><g-field name=\"dexterity_save_prof\" label=\"\" /></td><td class=\"num\"><g-value name=\"dexterity_save\" /></td></tr>\n        <tr><td>CON</td><td class=\"tick\"><g-field name=\"constitution_save_prof\" label=\"\" /></td><td class=\"num\"><g-value name=\"constitution_save\" /></td></tr>\n        <tr><td>INT</td><td class=\"tick\"><g-field name=\"intelligence_save_prof\" label=\"\" /></td><td class=\"num\"><g-value name=\"intelligence_save\" /></td></tr>\n        <tr><td>WIS</td><td class=\"tick\"><g-field name=\"wisdom_save_prof\" label=\"\" /></td><td class=\"num\"><g-value name=\"wisdom_save\" /></td></tr>\n        <tr><td>CHA</td><td class=\"tick\"><g-field name=\"charisma_save_prof\" label=\"\" /></td><td class=\"num\"><g-value name=\"charisma_save\" /></td></tr>\n          </tbody>\n        </table>\n      </g-section>\n      <g-section title=\"Skills\"><g-field name=\"skill_profs\" label=\"\" /></g-section>\n      <g-section title=\"Feats\"><g-field name=\"feats\" label=\"\" /></g-section>\n    </div>\n\n    <div class=\"col wide\">\n      <g-section title=\"Attacks\"><g-field name=\"attacks\" label=\"\" /></g-section>\n      <g-section title=\"Equipment\">\n        <g-field name=\"equipment\" label=\"\" />\n        <p class=\"hint\">\n          Carrying <g-value name=\"carried_weight\" /> of <g-value name=\"carry_capacity\" /> lb\n        </p>\n      </g-section>\n      <g-if test=\"is_caster\">\n        <g-section title=\"Spellcasting\">\n          <div class=\"spell-stats\">\n            <g-field name=\"spell_ability\" />\n            <div class=\"stat\"><span class=\"stat-label\">Save DC</span><g-value name=\"spell_save_dc\" /></div>\n            <div class=\"stat\"><span class=\"stat-label\">Attack</span><g-value name=\"spell_attack\" /></div>\n            <div class=\"stat\"><span class=\"stat-label\">Prepared</span><g-value name=\"prepared_count\" /></div>\n          </div>\n          <g-field name=\"spells\" label=\"\" />\n        </g-section>\n      </g-if>\n      <g-section title=\"Features &amp; Traits\"><g-field name=\"features\" label=\"\" /></g-section>\n    </div>\n  </div>\n\n  <g-field name=\"is_caster\" />\n  <g-field name=\"heroic_inspiration\" />\n  <g-field name=\"alignment\" />\n  <g-field name=\"player_name\" />\n  <g-field name=\"armor_bonus\" />\n  <g-field name=\"notes\" />\n</div>",
  "styles": ".sheet-5e { display: grid; gap: 18px; }\n.identity { display: grid; gap: 10px; }\n.identity-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\n.abilities { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 10px; }\n.ability { text-align: center; border: 1px solid var(--border); border-radius: 10px; padding: 8px 6px; }\n.ability .mod { font-size: 20px; font-weight: 700; color: var(--gold); margin-top: 2px; }\n.vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; }\n.stat { text-align: center; border: 1px solid var(--border); border-radius: 10px; padding: 8px; }\n.stat-label { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }\n.hp { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; }\n.columns { display: grid; grid-template-columns: 1fr 2fr; gap: 18px; }\n.col { display: grid; gap: 14px; align-content: start; }\n.saves { width: 100%; border-collapse: collapse; }\n.saves td { padding: 3px 4px; border-bottom: 1px solid var(--border); }\n.saves .num { text-align: right; font-weight: 600; }\n.saves .tick { width: 24px; text-align: center; }\n.spell-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; margin-bottom: 10px; }\n.hint { font-size: 11px; color: var(--text-muted); margin: 6px 0 0; }\n@media (max-width: 720px) { .columns { grid-template-columns: 1fr; } }"
}
